# Master refresh always checks https://uma.moe/api/ver; Postgres is not required.
# Legacy DATABASE_URL is accepted for compatibility and does not control refresh.
DATABASE_URL=
MASTER_REFRESH_INTERVAL_SECONDS=300
PURGE_ON_REFRESH=false

# Optional phone-friendly confirmed timeline updates.
# In Docker, this should point at the container path for the host-mounted /opt config file.
CONFIRMED_BANNER_DATES_URL=
CONFIRMED_BANNER_DATES_PATH=/config/confirmed_global_banner_dates.csv
CONFIRMED_BANNER_DATES_REFRESH_INTERVAL_SECONDS=60

ALLOWED_ORIGINS=https://uma.moe,https://www.uma.moe,https://beta.uma.moe
API_PROTECTION_BYPASS=false
DEBUG_MODE=false
STATIC_AUTH_TOKEN=
BETA_STATIC_AUTH_TOKEN=

REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=umamoe
# Resources validates browser proofs from Redis. Backend is responsible for issuing them.
# Optional Docker-network listener for internal resource consumers. Do not publish this port.
RESOURCES_INTERNAL_PORT=3204

# Legacy local Docker Compose setting; not required for master refresh.
RESOURCE_DATABASE_URL=

# Required for `cargo run -- refresh --purge` and `cargo run -- purge`.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Public site root. The resource API is served under /resources, so this should be the site base.
PUBLIC_BASE_URL=https://uma.moe

# Required for `cargo run -- assets-publish`. Use an R2 token scoped to the asset bucket only.
ASSETS_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
ASSETS_S3_REGION=auto
ASSETS_S3_ACCESS_KEY_ID=
ASSETS_S3_SECRET_ACCESS_KEY=
# Origins whose cached copies of replaced images are purged.
ASSETS_PURGE_ORIGINS=https://uma.moe,https://beta.uma.moe

# Game art: the game's asset bundle key (hex) and the switch that lets this server publish.
# Only production publishes.
GAME_ASSET_KEY=
GAME_ART_PUBLISH=false
# A publishing server also publishes JP's images, as a tree of their own below jp/. false turns that off.
# JP_GAME_ART_PUBLISH=false
# The JP resource set is generated from the JP master and served below /resources/jp/. false turns that off.
# JP_RESOURCES=false
# The version endpoint, asked as ?region=jp for JP. Set it to use a local backend.
# GAME_VERSION_URL=https://uma.moe/api/ver

# Shared store of news archives and name translations, in a store/ folder.
# The bucket that holds the store/ folder (default: the asset bucket).
STORE_S3_BUCKET=
# The store's own R2 token, both or neither; unset, the asset token is used. Same endpoint as the assets.
# Read & Write for the publishing server, Read only is enough for a reading server.
# STORE_S3_ACCESS_KEY_ID=
# STORE_S3_SECRET_ACCESS_KEY=
# How often the publishing server collects news and new names into the store (seconds, at least 300).
# STORE_SYNC_INTERVAL_SECONDS=1800
# Publishing server only: translates the names only JP has released into the store.
# ANTHROPIC_API_KEY=

# Optional logging override.
RUST_LOG=umamoe_resources=info,info
