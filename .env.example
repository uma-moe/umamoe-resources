# Required for `cargo run`, `cargo run -- serve`, and `cargo run -- refresh`
# when you want automatic master_versions-driven refreshes.
DATABASE_URL=postgresql://user:password@localhost:5432/umamoe
MASTER_REFRESH_INTERVAL_SECONDS=300

ALLOWED_ORIGINS=https://uma.moe,https://www.uma.moe,https://beta.uma.moe
API_PROTECTION_BYPASS=false
DEBUG_MODE=false
STATIC_AUTH_TOKEN=
BETA_STATIC_AUTH_TOKEN=

REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=umamoe
# Resources validates browser proofs from Redis. Backend is responsible for issuing them.
# Optional Docker-network listener for internal resource consumers. Do not publish this port.
RESOURCES_INTERNAL_PORT=3204

# Local Docker Compose only. This is mapped into DATABASE_URL inside the container.
# Use host.docker.internal or another container hostname, not 127.0.0.1.
RESOURCE_DATABASE_URL=

# Required for `cargo run -- refresh --purge` and `cargo run -- purge`.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Public site root. The resource API is served under /resources, so this should be the site base.
PUBLIC_BASE_URL=https://uma.moe

# Optional logging override.
RUST_LOG=umamoe_resources=info,info